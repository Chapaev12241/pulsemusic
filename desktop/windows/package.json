{
  "name": "pulse-desktop",
  "version": "2.0.0",
  "description": "Pulse for Windows — music, shared library and connected playback",
  "author": "Pulse",
  "private": true,
  "main": "main.cjs",
  "scripts": {"start": "electron .", "test": "node --test security.test.cjs", "dist": "electron-builder --win --x64 --publish never"},
  "devDependencies": {"electron": "45.3.2", "electron-builder": "26.18.0"},
  "build": {
    "appId": "com.chapaev12241.pulsemusic.windows",
    "productName": "Pulse",
    "asar": true,
    "directories": {"output": "release", "buildResources": "assets"},
    "files": ["main.cjs", "preload.cjs", "security.cjs", "offline.html", "assets/**", "package.json"],
    "win": {"icon": "assets/icon.png", "target": ["nsis", "portable"]},
    "nsis": {"artifactName": "Pulse-Setup-${version}-x64.exe", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "runAfterFinish": false},
    "portable": {"artifactName": "Pulse-Portable-${version}-x64.exe"}
  }
}
